        "\n",
        "# ============================================================\n",
        "# GSM A5/1 — COMPLETE SLIDE EXAMPLE\n",
        "# Majority clocking + feedback XOR + shifting + keystream\n",
        "# One self-contained Jupyter / Google Colab cell\n",
        "# ============================================================\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import Rectangle\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 1 — ORIGINAL REGISTERS FROM OUR SLIDE\n",
        "# Bit 0 is displayed on the LEFT.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "states = {\n",
        "    \"X\": \"1010101010101010101\",      # 19 bits\n",
