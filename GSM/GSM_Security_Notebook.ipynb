        "\n",
        "# ============================================================\n",
        "# GSM SECURITY LAB — PART 1\n",
        "# Scenario 1: Legitimate GSM Subscriber Authentication (A3)\n",
        "#\n",
        "# Compatible with Google Colab and JupyterLab\n",
        "# ============================================================\n",
        "\n",
        "# STEP 1 — Import the required Python libraries\n",
        "\n",
        "import sys\n",
        "import subprocess\n",
        "import importlib.util\n",
        "import secrets                  # Generate secure random challenges\n",
        "import hmac                     # Calculate and compare authentication responses\n",
        "import hashlib                  # Provide the SHA-256 hash function\n",
        "#How does secrets generate random values? The secrets library uses the operating system's cryptographically secure random number generator (CSPRNG).\n",
        "#The operating system collects entropy from various system sources and uses a secure algorithm to generate unpredictable values.\n",
        "#´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´#\n",
        "# Install Matplotlib only if it is not already available.\n",
        "# This works in both Google Colab and JupyterLab.\n",
        "if importlib.util.find_spec(\"matplotlib\") is None:\n",
        "    subprocess.check_call([\n",
        "        sys.executable, \"-m\", \"pip\", \"install\", \"matplotlib\"\n",
        "    ])\n",
        "\n",
        "import matplotlib.pyplot as plt  # Create the authentication diagram\n",
        "\n",
        "#´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´#\n",
        "# STEP 2 — Define an educational version of GSM A3\n",
        "\n",
        "def demo_A3(key, rand):\n",
        "    \"\"\"\n",
        "    Simulate the GSM A3 authentication function.\n",
        "\n",
        "    Parameters:\n",
        "        key  : Subscriber's secret key Ki (16 bytes)\n",
        "        rand : Network challenge RAND (16 bytes)\n",
        "\n",
        "    Returns:\n",
        "        SRES : Authentication response (4 bytes = 32 bits)\n",
        "\n",
        "    IMPORTANT:\n",
        "        This function uses HMAC-SHA256 as an educational\n",
        "        substitute. It does NOT implement real GSM A3/COMP128.\n",
        "    \"\"\"\n",
        "\n",
        "    # Create the HMAC object using the key and RAND.\n",
        "    hmac_object = hmac.new(key, rand, hashlib.sha256)#hashlib.sha256: The hash algorithm HMAC will use\n",
        "\n",
        "    # Calculate the complete 256-bit result.\n",
        "    full_result = hmac_object.digest()\n",
        "\n",
        "    # Extract the first 4 bytes (32 bits).[:4] Python slicing selects bytes at positions 0, 1, 2, and 3. 4 bytes = 32 bits\n",
        "    sres = full_result[:4]\n",
        "\n",
        "    # Return the authentication response.\n",
        "    return sres\n",
        "\n",
        "\n",
        "# STEP 3 — Define the subscriber's secret key (Ki)\n",
        "\n",
        "# In GSM, Ki is stored in the SIM and the operator's AuC.\n",
        "# The secret key is never transmitted over the radio interface.\n",
        "Ki_SIM = bytes.fromhex(\"00112233445566778899AABBCCDDEEFF\")\n",
        "\n",
        "# The network has the same subscriber-specific secret key.\n",
        "Ki_NETWORK = Ki_SIM\n",
        "\n",
        "\n",
        "# STEP 4 — Generate the network's random challenge (RAND)\n",
        "\n",
        "# Generate 16 random bytes (128 bits).\n",
        "# A new RAND is generated for this authentication attempt.\n",
        "RAND = secrets.token_bytes(16)\n",
        "\n",
        "\n",
        "# STEP 5 — SIM calculates its response (SRES)\n",
        "\n",
        "# The SIM applies A3 using Ki and the received RAND.\n",
        "sim_sres = demo_A3(Ki_SIM, RAND)\n",
        "\n",
        "\n",
        "# STEP 6 — Network calculates the expected SRES\n",
        "\n",
        "# The network's expected response is calculated using\n",
        "# the same RAND and its copy of the subscriber's Ki.\n",
        "network_sres = demo_A3(Ki_NETWORK, RAND)\n",
        "\n",
        "\n",
        "# STEP 7 — Verify the subscriber's identity\n",
        "\n",
        "# Compare both responses.\n",
        "# If they match, subscriber authentication succeeds.\n",
        "authenticated = hmac.compare_digest(sim_sres, network_sres)\n",
        "\n",
        "\n",
        "# STEP 8 — Display the authentication results\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"SCENARIO 1: LEGITIMATE GSM SUBSCRIBER AUTHENTICATION\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"RAND (128 bits)       : {RAND.hex()}\")\n",
        "print(f\"SIM SRES (32 bits)    : {sim_sres.hex()}\")\n",
        "print(f\"Expected SRES        : {network_sres.hex()}\")\n",
        "\n",
        "print(\"-\" * 60)\n",
        "\n",
        "if authenticated:\n",
        "    print(\"RESULT: Subscriber authentication SUCCESSFUL\")\n",
        "else:\n",
        "    print(\"RESULT: Subscriber authentication FAILED\")\n",
        "\n",
        "print(\"Network authenticated by SIM: NO\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "#´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´\n",
        "# STEP 9 — Visualize the challenge-response exchange\n",
        "#´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´´\n",
        "# Create a figure and drawing area.\n",
        "fig, ax = plt.subplots(figsize=(11, 4))\n",
        "\n",
        "# Define the coordinate system.\n",
        "ax.set_xlim(0, 10)\n",
        "ax.set_ylim(0, 4)\n",
        "\n",
        "# Hide axes because this is a protocol diagram.\n",
        "ax.axis(\"off\")\n",
        "\n",
        "\n",
        "# Reusable function for drawing GSM components.\n",
        "def draw_node(ax, x, y, label, color):\n",
        "    \"\"\"\n",
        "    Draw a labeled network component in the diagram.\n",
        "    \"\"\"\n",
        "    ax.text(\n",
        "        x, y, label,\n",
        "        ha=\"center\",\n",
        "        va=\"center\",\n",
        "        fontsize=11,\n",
        "        fontweight=\"bold\",\n",
        "        bbox=dict(\n",
        "            boxstyle=\"round,pad=0.7\",\n",
        "            facecolor=color,\n",
        "            edgecolor=\"gray\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "# Draw the SIM and the network.\n",
        "draw_node(ax, 2, 2, \"SIM\\nSecret Ki\", \"lightblue\")\n",
        "draw_node(ax, 8, 2, \"Network\\nAuC / Secret Ki\", \"lightgreen\")\n",
        "\n",
        "\n",
        "# Draw RAND: Network -> SIM\n",
        "ax.annotate(\n",
        "    \"1. RAND (128 bits)\",\n",
        "    xy=(3.1, 2.7),\n",
        "    xytext=(6.9, 2.7),\n",
        "    arrowprops=dict(arrowstyle=\"->\", lw=2),\n",
        "    ha=\"center\",\n",
        "    fontsize=11\n",
        ")\n",
        "\n",
        "\n",
        "# Draw SRES: SIM -> Network\n",
        "ax.annotate(\n",
        "    \"2. SRES (32 bits)\",\n",
        "    xy=(6.9, 1.3),\n",
        "    xytext=(3.1, 1.3),\n",
        "    arrowprops=dict(arrowstyle=\"->\", lw=2),\n",
        "    ha=\"center\",\n",
        "    fontsize=11\n",
        ")\n",
        "\n",
        "\n",
        "# Add the diagram title.\n",
        "ax.set_title(\n",
        "    \"GSM A3 — Challenge-Response Authentication\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "# Display the diagram.\n",
        "plt.show()\n",
        "result = hashlib.sha256(b\"Hello\")\n"
      ]
    },
