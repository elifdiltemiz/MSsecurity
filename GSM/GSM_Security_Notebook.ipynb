        "\n",
        "import secrets\n",
        "import hmac\n",
        "import hashlib\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, HTML, clear_output\n",
        "\n",
        "# Educational A3 substitute\n",
        "def demo_A3(key, rand):\n",
        "    return hmac.new(\n",
        "        key, rand, hashlib.sha256\n",
        "    ).digest()[:4]\n",
        "\n",
        "# One fixed challenge during the demonstration\n",
        "RAND = secrets.token_bytes(16)\n",
        "\n",
        "# Editable keys\n",
        "sim_input = widgets.Text(\n",
        "    value=\"00112233445566778899AABBCCDDEEFF\",\n",
        "    description=\"SIM Ki:\",\n",
        "    layout=widgets.Layout(width=\"520px\"),\n",
        "    style={\"description_width\": \"90px\"}\n",
        ")\n",
        "\n",
        "network_input = widgets.Text(\n",
        "    value=\"00112233445566778899AABBCCDDEEFF\",\n",
        "    description=\"Network Ki:\",\n",
        "    layout=widgets.Layout(width=\"520px\"),\n",
        "    style={\"description_width\": \"90px\"}\n",
        ")\n",
        "\n",
        "check_button = widgets.Button(\n",
        "    description=\"Authenticate\",\n",
        "    button_style=\"primary\",\n",
        "    icon=\"check\"\n",
        ")\n",
        "\n",
        "reset_button = widgets.Button(\n",
        "    description=\"Reset keys\",\n",
        "    icon=\"refresh\"\n",
        ")\n",
        "\n",
        "new_rand_button = widgets.Button(\n",
        "    description=\"New RAND\",\n",
        "    icon=\"random\"\n",
        ")\n",
        "\n",
        "output = widgets.Output()\n",
        "\n",
        "def authenticate(button=None):\n",
        "    with output:\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        try:\n",
        "            sim_key = bytes.fromhex(sim_input.value)\n",
        "            network_key = bytes.fromhex(network_input.value)\n",
        "\n",
        "            if len(sim_key) != 16 or len(network_key) != 16:\n",
        "                raise ValueError(\n",
        "                    \"Each Ki must contain exactly 16 bytes \"\n",
        "                    \"(32 hexadecimal characters).\"\n",
        "                )\n",
        "\n",
        "            sim_sres = demo_A3(sim_key, RAND)\n",
        "            network_sres = demo_A3(network_key, RAND)\n",
        "\n",
        "            valid = hmac.compare_digest(\n",
        "                sim_sres, network_sres\n",
        "            )\n",
        "\n",
        "            print(\"RAND:        \", RAND.hex())\n",
        "            print(\"SIM Ki:      \", sim_key.hex())\n",
        "            print(\"Network Ki:  \", network_key.hex())\n",
        "            print(\"-\" * 50)\n",
        "            print(\"SIM SRES:    \", sim_sres.hex())\n",
        "            print(\"Expected:    \", network_sres.hex())\n",
        "\n",
        "            if valid:\n",
        "                display(HTML(\n",
        "                    \"<h2 style='color:green'>\"\n",
        "                    \"✓ AUTHENTICATION SUCCESSFUL</h2>\"\n",
        "                ))\n",
        "            else:\n",
        "                display(HTML(\n",
        "                    \"<h2 style='color:red'>\"\n",
        "                    \"✗ AUTHENTICATION FAILED</h2>\"\n",
        "                ))\n",
        "\n",
        "        except ValueError as error:\n",
        "            print(\"Invalid key:\", error)\n",
        "\n",
        "def reset_keys(button):\n",
        "    original = \"00112233445566778899AABBCCDDEEFF\"\n",
        "    sim_input.value = original\n",
        "    network_input.value = original\n",
        "    authenticate()\n",
        "\n",
        "def generate_new_rand(button):\n",
        "    global RAND\n",
        "    RAND = secrets.token_bytes(16)\n",
        "    authenticate()\n",
        "\n",
        "check_button.on_click(authenticate)\n",
        "reset_button.on_click(reset_keys)\n",
        "new_rand_button.on_click(generate_new_rand)\n",
        "\n",
        "display(widgets.VBox([\n",
        "    widgets.HTML(\"<h3>GSM A3 — Live Authentication Lab</h3>\"),\n",
        "    sim_input,\n",
        "    network_input,\n",
        "    widgets.HBox([\n",
        "        check_button, reset_button, new_rand_button\n",
        "    ]),\n",
        "    output\n",
        "]))\n",
        "\n",
        "authenticate()\n"
      ]
    },
