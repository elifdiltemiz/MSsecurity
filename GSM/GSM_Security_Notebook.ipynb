        "\n",
        "# ============================================================\n",
        "# GSM A5/1 — UNDERSTANDING MAJORITY CLOCKING\n",
        "# ============================================================\n",
        "\n",
        "# Example clock-control bits from the three registers.\n",
        "R1_clock = 1\n",
        "R2_clock = 0\n",
        "R3_clock = 1\n",
        "\n",
        "# The majority is the value appearing at least twice.\n",
        "majority_bit = 1 if (\n",
        "    R1_clock + R2_clock + R3_clock\n",
        ") >= 2 else 0\n",
        "\n",
        "print(\"A5/1 — MAJORITY CLOCKING\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "print(\"R1 clock bit:\", R1_clock)\n",
        "print(\"R2 clock bit:\", R2_clock)\n",
        "print(\"R3 clock bit:\", R3_clock)\n",
        "\n",
        "print(\"\\nMajority bit:\", majority_bit)\n",
        "\n",
        "# A register advances only when its bit matches the majority.\n",
        "print(\"\\nClocking decisions:\")\n",
        "\n",
        "print(\"R1 advances:\", R1_clock == majority_bit)\n",
        "print(\"R2 advances:\", R2_clock == majority_bit)\n",
        "print(\"R3 advances:\", R3_clock == majority_bit)\n"
