        "# ============================================================\n",
        "# GSM SECURITY LAB — BACKHAUL EAVESDROPPING\n",
        "# CELL 1: SECURITY EXPERIMENT\n",
        "# ============================================================\n",
        "\n",
        "import secrets\n",
        "from cryptography.hazmat.primitives.ciphers.aead import AESGCM\n",
        "\n",
        "# AES-GCM is used for teaching, NOT actual GSM A5 encryption.\n",
        "\n",
        "# STEP 1 — Prepare the message.\n",
        "message = \"Hello Bob, the meeting starts at 10:00.\"\n",
        "plaintext = message.encode(\"utf-8\")     #.encode(\"utf-8\") → Converts the string into bytes.\n",
        "\n",
        "# STEP 2 — Create separate keys for the radio and backhaul.\n",
        "radio_key = AESGCM.generate_key(bit_length=256)\n",
        "backhaul_key = AESGCM.generate_key(bit_length=256)\n",
        "\n",
        "# STEP 3 — Define encryption and decryption functions.\n",
        "def encrypt(key, data):\n",
        "    # Create an AES-GCM cipher with the provided key.\n",
        "    cipher = AESGCM(key)\n",
        "\n",
        "    # Generate a fresh nonce for this encryption.\n",
        "    nonce = secrets.token_bytes(12)\n",
        "\n",
        "    # Return the nonce and encrypted data.\n",
        "    return nonce, cipher.encrypt(nonce, data, None)\n",
        "\n",
        "\n",
        "def decrypt(key, nonce, ciphertext):\n",
        "    # Recover the original data using the correct key.\n",
        "    return AESGCM(key).decrypt(nonce, ciphertext, None)\n",
        "\n",
        "\n",
        "print(\"ORIGINAL MESSAGE:\", message)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SCENARIO A — ENCRYPTED RADIO LINK\n",
        "# ============================================================\n",
        "\n",
        "# Mobile encrypts the message before radio transmission.\n",
        "radio_nonce, radio_ciphertext = encrypt(radio_key, plaintext)\n",
        "\n",
        "print(\"\\nSCENARIO A — MOBILE TO BTS\")\n",
        "print(\"Radio observer sees:\", radio_ciphertext.hex())\n",
        "\n",
        "# BTS decrypts the radio message.\n",
        "bts_plaintext = decrypt(\n",
        "    radio_key, radio_nonce, radio_ciphertext\n",
        ")\n",
        "\n",
        "print(\"BTS recovers:\", bts_plaintext.decode(\"utf-8\"))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SCENARIO B — UNENCRYPTED BACKHAUL\n",
        "# ============================================================\n",
        "\n",
        "# Assume the BTS forwards plaintext without protection.\n",
        "backhaul_payload = bts_plaintext\n",
        "\n",
        "# A passive attacker observing this link reads the message.\n",
        "print(\"\\nSCENARIO B — UNENCRYPTED BACKHAUL\")\n",
        "print(\"Attacker reads:\", backhaul_payload.decode(\"utf-8\"))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SCENARIO C — ENCRYPTED BACKHAUL\n",
        "# ============================================================\n",
        "\n",
        "# BTS encrypts the message before forwarding it.\n",
        "backhaul_nonce, backhaul_ciphertext = encrypt(\n",
        "    backhaul_key, bts_plaintext\n",
        ")\n",
        "\n",
        "print(\"\\nSCENARIO C — ENCRYPTED BACKHAUL\")\n",
        "print(\"Attacker sees:\", backhaul_ciphertext.hex())\n",
        "\n",
        "# MSC decrypts the protected backhaul transmission.\n",
        "msc_plaintext = decrypt(\n",
        "    backhaul_key, backhaul_nonce, backhaul_ciphertext\n",
        ")\n",
        "\n",
        "print(\"MSC recovers:\", msc_plaintext.decode(\"utf-8\"))\n",
        "\n",
        "\n",
        "print(\"\\nCONCLUSION:\")\n",
        "print(\"Radio encryption alone is not end-to-end encryption.\")\n",
        "print(\"An unencrypted backhaul can expose the message.\")\n",
        "# ============================================================\n",
        "# CELL 2 — VISUALIZE THE BACKHAUL ATTACK\n",
        "# ============================================================\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Draw one network architecture with its security status.\n",
        "def draw_network(ax, protected):\n",
        "\n",
        "    ax.set_xlim(0, 10)\n",
        "    ax.set_ylim(0, 4)\n",
        "    ax.axis(\"off\")\n",
        "\n",
        "    # Network components and their positions.\n",
        "    nodes = [\n",
        "        (1, \"Mobile\"),\n",
        "        (4, \"BTS\"),\n",
        "        (8, \"MSC\")\n",
        "    ]\n",
        "\n",
        "    # Draw the components.\n",
        "    for x, name in nodes:\n",
        "        ax.text(\n",
        "            x, 2.8, name,\n",
        "            ha=\"center\", va=\"center\",\n",
        "            fontsize=12, fontweight=\"bold\",\n",
        "            bbox=dict(\n",
        "                boxstyle=\"round,pad=0.6\",\n",
        "                facecolor=\"lightblue\",\n",
        "                edgecolor=\"gray\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "    # Radio communication is encrypted.\n",
        "    ax.annotate(\n",
        "        \"\", xy=(3.3, 2.8), xytext=(1.7, 2.8),\n",
        "        arrowprops=dict(arrowstyle=\"->\", color=\"green\", lw=3)\n",
        "    )\n",
        "\n",
        "    ax.text(\n",
        "        2.5, 3.2, \"Encrypted radio\",\n",
        "        ha=\"center\", color=\"green\", fontsize=10\n",
        "    )\n",
        "\n",
        "    # Backhaul protection changes between scenarios.\n",
        "    link_color = \"green\" if protected else \"red\"\n",
        "    link_label = \"Encrypted backhaul\" if protected else \"Plaintext backhaul\"\n",
        "\n",
        "    ax.annotate(\n",
        "        \"\", xy=(7.3, 2.8), xytext=(4.7, 2.8),\n",
        "        arrowprops=dict(arrowstyle=\"->\", color=link_color, lw=3)\n",
        "    )\n",
        "\n",
        "    ax.text(\n",
        "        6, 3.2, link_label,\n",
        "        ha=\"center\", color=link_color, fontsize=10\n",
        "    )\n",
        "\n",
        "    # The attacker observes the backhaul link.\n",
        "    ax.annotate(\n",
        "        \"\", xy=(6, 1.1), xytext=(6, 2.55),\n",
        "        arrowprops=dict(\n",
        "            arrowstyle=\"->\",\n",
        "            linestyle=\"--\",\n",
        "            color=\"red\",\n",
        "            lw=2\n",
        "        )\n",
        "    )\n",
        "\n",
        "    ax.text(\n",
        "        6, 0.75, \"Passive attacker\",\n",
        "        ha=\"center\",\n",
        "        fontsize=11,\n",
        "        fontweight=\"bold\",\n",
        "        color=\"red\"\n",
        "    )\n",
        "\n",
        "    # Display the attacker's observation.\n",
        "    result = (\n",
        "        \"Attacker sees ciphertext\"\n",
        "        if protected\n",
        "        else \"Attacker reads plaintext\"\n",
        "    )\n",
        "\n",
        "    ax.text(\n",
        "        6, 0.2, result,\n",
        "        ha=\"center\",\n",
        "        fontsize=11,\n",
        "        color=link_color\n",
        "    )\n",
        "\n",
        "\n",
        "# Draw the vulnerable and protected scenarios.\n",
        "fig, axes = plt.subplots(2, 1, figsize=(12, 7))\n",
        "\n",
        "draw_network(axes[0], protected=False)\n",
        "axes[0].set_title(\"Scenario B — Unencrypted Backhaul\")\n",
        "\n",
        "draw_network(axes[1], protected=True)\n",
        "axes[1].set_title(\"Scenario C — Encrypted Backhaul\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
