        "    \"Z\": \"11100001111000011110001\"   # 23 bits\n",
        "}\n",
        "\n",
        "config = {\n",
        "    \"X\": {\"clock\": 8,  \"taps\": [13, 16, 17, 18]},\n",
        "    \"Y\": {\"clock\": 10, \"taps\": [20, 21]},\n",
        "    \"Z\": {\"clock\": 10, \"taps\": [7, 20, 21, 22]}\n",
        "}\n",
        "\n",
        "assert [len(states[r]) for r in \"XYZ\"] == [19, 22, 23]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 2 — FUNCTIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def majority(a, b, c):\n",
        "    return int(a + b + c >= 2)\n",
        "\n",
        "def feedback_xor(bits, taps):\n",
        "    values = [int(bits[i]) for i in taps] #reads the bits at positions 13, 16, 17, and 18.\n",
        "    result = 0 # The result is: values = [0, 1, 0, 1]\n",
        "    for value in values:\n",
        "        result ^= value #result = result ^ value\n",
        "    return values, result #return ([0, 1, 0, 1], 0)\n",
        "    # ---------------------------------------\n",
        "# Iteration | Operation | Result\n",
        "# ---------------------------------------\n",
        "# Initial   |     —     |   0\n",
        "# 1         |  0 XOR 0  |   0\n",
        "# 2         |  0 XOR 1  |   1\n",
        "# 3         |  1 XOR 0  |   1\n",
        "# 4         |  1 XOR 1  |   0\n",
        "# ---------------------------------------\n",
        "# Final feedback XOR = 0\n",
        "\n",
        "def shift_register(bits, feedback):\n",
        "    # Bit 0 is on the left.\n",
        "    # Feedback enters at bit 0.\n",
        "    return str(feedback) + bits[:-1] # bits[:-1]: keeps everything except the last character.\n",
        "\n",
        "def xor_text(values):\n",
        "    return \" XOR \".join(map(str, values))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 3 — CLOCKING DECISION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "clock_bits = {\n",
        "    r: int(states[r][config[r][\"clock\"]])\n",
        "    for r in \"XYZ\"\n",
        "}\n",
        "\n",
        "m = majority(\n",
        "    clock_bits[\"X\"],\n",
        "    clock_bits[\"Y\"],\n",
        "    clock_bits[\"Z\"]\n",
        ")\n",
        "\n",
        "clocked = {\n",
        "    r: clock_bits[r] == m\n",
        "    for r in \"XYZ\"\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4 — FEEDBACK XOR AND SHIFT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "feedback_values = {}\n",
        "feedback_results = {}\n",
        "new_states = {}\n",
        "\n",
        "for r in \"XYZ\":\n",
        "\n",
        "    values, feedback = feedback_xor(\n",
        "        states[r],\n",
        "        config[r][\"taps\"]\n",
        "    )\n",
        "\n",
        "    feedback_values[r] = values\n",
        "    feedback_results[r] = feedback\n",
        "\n",
        "    if clocked[r]:\n",
        "        new_states[r] = shift_register(states[r], feedback)\n",
        "    else:\n",
        "        new_states[r] = states[r]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 5 — KEYSTREAM BEFORE AND AFTER CLOCKING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "old_output_bits = [\n",
        "    int(states[r][-1]) for r in \"XYZ\"\n",
        "]\n",
        "\n",
        "new_output_bits = [\n",
        "    int(new_states[r][-1]) for r in \"XYZ\"\n",
        "]\n",
        "\n",
        "old_keystream = (\n",
        "    old_output_bits[0]\n",
        "    ^ old_output_bits[1]\n",
        "    ^ old_output_bits[2]\n",
        ")\n",
        "\n",
        "new_keystream = (\n",
        "    new_output_bits[0]\n",
        "    ^ new_output_bits[1]\n",
        "    ^ new_output_bits[2]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 6 — DRAW ALL REGISTERS AND CALCULATIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(17, 12))\n",
        "ax.set_xlim(-2.5, 26)\n",
        "ax.set_ylim(-2.2, 16)\n",
        "ax.axis(\"off\")\n",
        "\n",
        "fig.patch.set_facecolor(\"white\")\n",
        "\n",
        "ax.text(\n",
        "    11.5, 15.3,\n",
        "    \"GSM A5/1 — Majority Clocking and XOR\",\n",
        "    fontsize=21, fontweight=\"bold\",\n",
        "    ha=\"center\", color=\"#17365D\"\n",
        ")\n",
        "\n",
        "ax.text(\n",
        "    11.5, 14.5,\n",
        "    f\"Majority = maj({clock_bits['X']}, \"\n",
        "    f\"{clock_bits['Y']}, {clock_bits['Z']}) = {m}\",\n",
        "    fontsize=16, fontweight=\"bold\",\n",
        "    ha=\"center\"\n",
        ")\n",
        "\n",
        "ax.text(\n",
        "    11.5, 13.8,\n",
        "    \"X shifts | Y holds | Z shifts\",\n",
        "    fontsize=14, ha=\"center\",\n",
        "    color=\"#167D54\"\n",
        ")\n",
        "\n",
        "CELL_W = 0.91\n",
        "CELL_H = 0.58\n",
        "\n",
        "def draw_register(bits, name, y, clock, taps, caption):\n",
        "\n",
        "    ax.text(\n",
        "        -2.0, y + 0.12,\n",
        "        name, fontsize=18,\n",
        "        fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    for i, value in enumerate(bits):\n",
        "\n",
        "        x = i * CELL_W\n",
        "\n",
        "        if i == clock:\n",
        "            color = \"#FAD4D4\"  # clocking bit\n",
        "        elif i in taps:\n",
        "            color = \"#FFF0A8\"  # feedback tap\n",
        "        else:\n",
        "            color = \"#EDF2F7\"\n",
        "\n",
        "        ax.add_patch(\n",
        "            Rectangle(\n",
        "                (x, y), CELL_W, CELL_H,\n",
        "                facecolor=color,\n",
        "                edgecolor=\"#64748B\",\n",
        "                linewidth=0.8\n",
        "            )\n",
        "        )\n",
        "\n",
        "        ax.text(\n",
        "            x + CELL_W / 2,\n",
        "            y + CELL_H / 2,\n",
        "            value,\n",
        "            ha=\"center\",\n",
        "            va=\"center\",\n",
        "            fontsize=12,\n",
        "            fontweight=\"bold\"\n",
        "        )\n",
        "\n",
        "    ax.text(\n",
        "        0, y - 0.37,\n",
        "        caption,\n",
        "        fontsize=11,\n",
        "        color=\"#475569\"\n",
        "    )\n",
        "\n",
        "def draw_after(bits, name, y):\n",
        "\n",
        "    ax.text(\n",
        "        -2.0, y + 0.12,\n",
        "        name, fontsize=15,\n",
        "        fontweight=\"bold\",\n",
        "        color=\"#167D54\"\n",
        "    )\n",
        "\n",
        "    for i, value in enumerate(bits):\n",
        "\n",
        "        x = i * CELL_W\n",
        "\n",
        "        ax.add_patch(\n",
        "            Rectangle(\n",
        "                (x, y), CELL_W, CELL_H,\n",
        "                facecolor=\"#DDF3E7\",\n",
        "                edgecolor=\"#64748B\",\n",
        "                linewidth=0.8\n",
        "            )\n",
        "        )\n",
        "\n",
        "        ax.text(\n",
        "            x + CELL_W / 2,\n",
        "            y + CELL_H / 2,\n",
        "            value,\n",
        "            ha=\"center\",\n",
        "            va=\"center\",\n",
        "            fontsize=12,\n",
        "            fontweight=\"bold\"\n",
        "        )\n",
        "\n",
        "# Original states\n",
        "before_y = {\"X\": 12.3, \"Y\": 8.6, \"Z\": 4.9}\n",
        "after_y = {\"X\": 10.6, \"Y\": 6.9, \"Z\": 3.2}\n",
        "\n",
        "for r in \"XYZ\":\n",
        "\n",
        "    clock = config[r][\"clock\"]\n",
        "    taps = config[r][\"taps\"]\n",
        "\n",
        "    status = \"SHIFT\" if clocked[r] else \"HOLD\"\n",
        "\n",
        "    draw_register(\n",
        "        states[r],\n",
        "        r + \" before\",\n",
        "        before_y[r],\n",
        "        clock,\n",
        "        taps,\n",
        "        f\"Clock bit = {clock_bits[r]} | \"\n",
        "        f\"Tap positions = {taps} | {status}\"\n",
        "    )\n",
        "\n",
        "    if clocked[r]:\n",
        "        equation = (\n",
        "            f\"{r} feedback: \"\n",
        "            f\"{xor_text(feedback_values[r])}\"\n",
        "            f\" = {feedback_results[r]}\"\n",
        "        )\n",
        "    else:\n",
        "        equation = (\n",
        "            f\"{r}: HOLD — no shift, state unchanged\"\n",
        "        )\n",
        "\n",
        "    ax.text(\n",
        "        0, before_y[r] - 0.82,\n",
        "        equation,\n",
        "        fontsize=12,\n",
        "        fontweight=\"bold\",\n",
        "        color=\"#167D54\" if clocked[r] else \"#C0392B\"\n",
        "    )\n",
        "\n",
        "    draw_after(\n",
        "        new_states[r],\n",
        "        r + \" after\",\n",
        "        after_y[r]\n",
        "    )\n",
        "\n",
        "# Keystream result\n",
        "ax.text(\n",
        "    11, 1.9,\n",
        "    \"Keystream after majority clocking\",\n",
        "    ha=\"center\",\n",
        "    fontsize=16,\n",
        "    fontweight=\"bold\",\n",
        "    color=\"#17365D\"\n",
        ")\n",
        "\n",
        "ax.text(\n",
        "    11, 1.1,\n",
        "    f\"{new_output_bits[0]} XOR \"\n",
        "    f\"{new_output_bits[1]} XOR \"\n",
        "    f\"{new_output_bits[2]} = {new_keystream}\",\n",
        "    ha=\"center\",\n",
        "    fontsize=20,\n",
        "    fontweight=\"bold\",\n",
        "    color=\"#167D54\"\n",
        ")\n",
        "\n",
        "ax.text(\n",
        "    11, 0.25,\n",
        "    \"Red = clocking bit | Yellow = feedback tap | \"\n",
        "    \"Green = state after clocking\",\n",
        "    ha=\"center\",\n",
        "    fontsize=11,\n",
        "    color=\"#475569\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 7 — PRINT EXACT CALCULATIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(\"A5/1 — COMPLETE SLIDE EXAMPLE\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "print(\"\\nCLOCKING BITS\")\n",
        "for r in \"XYZ\":\n",
        "    print(\n",
        "        f\"{r}[{config[r]['clock']}] = {clock_bits[r]}\"\n",
        "    )\n",
        "\n",
        "print(f\"\\nMajority = {m}\")\n",
        "\n",
        "print(\"\\nREGISTER FEEDBACK AND SHIFTING\")\n",
        "\n",
        "for r in \"XYZ\":\n",
        "\n",
        "    print(f\"\\nRegister {r}\")\n",
        "    print(\"Before:\", states[r])\n",
        "\n",
        "    if clocked[r]:\n",
        "        print(\n",
        "            \"Feedback:\",\n",
        "            xor_text(feedback_values[r]),\n",
        "            \"=\",\n",
        "            feedback_results[r]\n",
        "        )\n",
        "        print(\"Action: SHIFT\")\n",
        "    else:\n",
        "        print(\"Action: HOLD\")\n",
        "\n",
        "    print(\"After: \", new_states[r])\n",
        "\n",
        "print(\"\\nKEYSTREAM\")\n",
        "\n",
        "print(\n",
        "    \"Before clocking:\",\n",
        "    xor_text(old_output_bits),\n",
        "    \"=\",\n",
        "    old_keystream\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"After clocking: \",\n",
        "    xor_text(new_output_bits),\n",
        "    \"=\",\n",
        "    new_keystream\n",
        ")\n",
        "\n",
        "print(\"\\nFinal keystream bit:\", new_keystream)\n"
      ]
    }
  ],
