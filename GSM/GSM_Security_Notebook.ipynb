        "\n",
        "# ============================================================\n",
        "# part5: GSM SECURITY LAB — AES-CTR RADIO ENCRYPTION\n",
        "# CELL 1: SECURITY EXPERIMENT\n",
        "#A5\n",
        "# ============================================================\n",
        "\n",
        "import secrets\n",
        "from cryptography.hazmat.primitives.ciphers import (\n",
        "    Cipher, algorithms, modes\n",
        ")\n",
        "\n",
        "# AES-CTR is used for teaching, NOT actual GSM A5 encryption.\n",
        "\n",
        "\n",
        "# STEP 1 — Prepare the message.\n",
        "message = \"Hello Bob, the meeting starts at 10:00.\"\n",
        "plaintext = message.encode(\"utf-8\")  # Convert text into bytes.\n",
        "\n",
        "\n",
        "# STEP 2 — Generate a shared AES key and nonce.\n",
        "radio_key = secrets.token_bytes(16)  # 128-bit AES key.\n",
        "nonce = secrets.token_bytes(8)       # 64-bit random nonce.\n",
        "\n",
        "# Define the GSM TDMA frame number.\n",
        "frame_number = 1000\n",
        "\n",
        "# Define the initial AES block counter.\n",
        "block_counter = 0\n",
        "\n",
        "\n",
        "# STEP 3 — Define encryption and decryption functions.\n",
        "def encrypt(key, nonce, frame, counter, data):\n",
        "\n",
        "    # Build the 128-bit initial AES-CTR input:\n",
        "    # 8-byte nonce + 4-byte frame + 4-byte block counter.\n",
        "    initial_counter = (\n",
        "        nonce\n",
        "        + frame.to_bytes(4, \"big\")\n",
        "        + counter.to_bytes(4, \"big\")\n",
        "    )\n",
        "\n",
        "    # Create an AES cipher in CTR mode.\n",
        "    cipher = Cipher(\n",
        "        algorithms.AES(key),\n",
        "        modes.CTR(initial_counter)\n",
        "    )\n",
        "\n",
        "    # Encrypt the data.\n",
        "    # AES-CTR automatically increments the counter.\n",
        "    encryptor = cipher.encryptor()\n",
        "    #keystream is generated internally by AES-CTR when call encryptor.update(data)\n",
        "    return encryptor.update(data) + encryptor.finalize()\n",
        "\n",
        "\n",
        "def decrypt(key, nonce, frame, counter, ciphertext):\n",
        "\n",
        "    # AES-CTR uses the same operation for decryption.\n",
        "    return encrypt(key, nonce, frame, counter, ciphertext)\n",
        "\n",
        "\n",
        "print(\"ORIGINAL MESSAGE:\", message)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SCENARIO A — ENCRYPTED RADIO LINK\n",
        "# ============================================================\n",
        "\n",
        "# Mobile encrypts the message before radio transmission.\n",
        "radio_ciphertext = encrypt(\n",
        "    radio_key, nonce, frame_number, block_counter, plaintext\n",
        ")\n",
        "\n",
        "print(\"\\nSCENARIO A — MOBILE TO BTS\")\n",
        "print(\"TDMA frame number:\", frame_number)\n",
        "print(\"Initial block counter:\", block_counter)\n",
        "print(\"Radio observer sees:\", radio_ciphertext.hex())\n",
        "\n",
        "# BTS decrypts using the same key, nonce, frame and counter.\n",
        "bts_plaintext = decrypt(\n",
        "    radio_key, nonce, frame_number, block_counter,\n",
        "    radio_ciphertext\n",
        ")\n",
        "\n",
        "print(\"BTS recovers:\", bts_plaintext.decode(\"utf-8\"))\n",
        "print(\"Decryption successful:\", bts_plaintext == plaintext)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SCENARIO B — CHANGE THE TDMA FRAME NUMBER\n",
        "# ============================================================\n",
        "\n",
        "# Change the TDMA frame number.\n",
        "new_frame_number = 1001\n",
        "\n",
        "# Encrypt the SAME message using the SAME key and nonce,\n",
        "# but a DIFFERENT frame number.\n",
        "new_ciphertext = encrypt(\n",
        "    radio_key, nonce, new_frame_number,\n",
        "    block_counter, plaintext\n",
        ")\n",
        "\n",
        "print(\"\\nSCENARIO B — NEW TDMA FRAME\")\n",
        "print(\"Original frame:\", frame_number)\n",
        "print(\"New frame:\", new_frame_number)\n",
        "\n",
        "print(\"Original ciphertext:\", radio_ciphertext.hex())\n",
        "print(\"New ciphertext:     \", new_ciphertext.hex())\n",
        "\n",
        "print(\"Ciphertexts differ:\", radio_ciphertext != new_ciphertext)\n",
        "\n",
        "# ============================================================\n",
        "# GSM AES-CTR — FRAME NUMBER AND CIPHERTEXT VISUALIZATION\n",
        "# Run after the AES-CTR encryption experiment.\n",
        "# ============================================================\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import FancyBboxPatch\n",
        "\n",
        "# STEP 1 — Create the figure.\n",
        "fig, ax = plt.subplots(figsize=(13, 7))\n",
        "\n",
        "ax.set_xlim(0, 13)\n",
        "ax.set_ylim(0, 8)\n",
        "ax.axis(\"off\")\n",
        "\n",
        "\n",
        "# STEP 2 — Define a function to draw a labeled box.\n",
        "def draw_box(x, y, width, height, title, value, color):\n",
        "\n",
        "    # Create a rounded rectangle.\n",
        "    box = FancyBboxPatch(\n",
        "        (x, y), width, height,\n",
        "        boxstyle=\"round,pad=0.12\",\n",
        "        facecolor=color,\n",
        "        edgecolor=\"#607080\",\n",
        "        linewidth=1.3\n",
        "    )\n",
        "\n",
        "    ax.add_patch(box)\n",
        "\n",
        "    # Display the title inside the box.\n",
        "    ax.text(\n",
        "        x + width / 2, y + height * 0.7,\n",
        "        title,\n",
        "        ha=\"center\", va=\"center\",\n",
        "        fontsize=11, fontweight=\"bold\"\n",
        "    )\n",
        "\n",
        "    # Display the value inside the box.\n",
        "    ax.text(\n",
        "        x + width / 2, y + height * 0.3,\n",
        "        value,\n",
        "        ha=\"center\", va=\"center\",\n",
        "        fontsize=9, family=\"monospace\"\n",
        "    )\n",
        "\n",
        "\n",
        "# STEP 3 — Define a function to draw arrows.\n",
        "def draw_arrow(x1, y1, x2, y2):\n",
        "\n",
        "    ax.annotate(\n",
        "        \"\",\n",
        "        xy=(x2, y2),\n",
        "        xytext=(x1, y1),\n",
        "        arrowprops=dict(\n",
        "            arrowstyle=\"->\",\n",
        "            color=\"#506070\",\n",
        "            linewidth=2\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "# STEP 4 — Compare two TDMA frame numbers.\n",
        "frames = [1000, 1001]\n",
        "\n",
        "# Use different colors for the two scenarios.\n",
        "colors = [\"#DCEAFE\", \"#D9F1E4\"]\n",
        "\n",
        "# Store the ciphertexts for comparison.\n",
        "ciphertexts = []\n",
        "\n",
        "for i, frame in enumerate(frames):\n",
        "\n",
        "    # Position each scenario on the diagram.\n",
        "    x = 0.6 + i * 6.5\n",
        "\n",
        "    # Generate a keystream by encrypting zero bytes.\n",
        "    # AES-CTR XORs its keystream with the input.\n",
        "    # Zero XOR keystream = keystream.\n",
        "    keystream = encrypt(\n",
        "        radio_key,\n",
        "        nonce,\n",
        "        frame,\n",
        "        block_counter,\n",
        "        bytes(len(plaintext))\n",
        "    )\n",
        "\n",
        "    # Encrypt the original message using AES-CTR.\n",
        "    encrypted = encrypt(\n",
        "        radio_key,\n",
        "        nonce,\n",
        "        frame,\n",
        "        block_counter,\n",
        "        plaintext\n",
        "    )\n",
        "\n",
        "    # Save the ciphertext for comparison.\n",
        "    ciphertexts.append(encrypted)\n",
        "\n",
        "    # Show the shared key and frame number.\n",
        "    draw_box(\n",
        "        x, 6.2, 5.2, 0.9,\n",
        "        f\"TDMA FRAME {frame}\",\n",
        "        \"Same AES key + Same nonce\",\n",
        "        colors[i]\n",
        "    )\n",
        "\n",
        "    draw_arrow(x + 2.6, 6.1, x + 2.6, 5.6)\n",
        "\n",
        "    # Show AES-CTR and its input parameters.\n",
        "    draw_box(\n",
        "        x + 0.8, 4.6, 3.6, 0.9,\n",
        "        \"AES-CTR\",\n",
        "        f\"Frame: {frame} | Counter: {block_counter}\",\n",
        "        \"#E6E9EF\"\n",
        "    )\n",
        "\n",
        "    draw_arrow(x + 2.6, 4.5, x + 2.6, 4.0)\n",
        "\n",
        "    # Display the generated keystream.\n",
        "    draw_box(\n",
        "        x, 3.0, 5.2, 0.9,\n",
        "        \"Generated Keystream\",\n",
        "        keystream.hex()[:32] + \"...\",\n",
        "        colors[i]\n",
        "    )\n",
        "\n",
        "    draw_arrow(x + 2.6, 2.9, x + 2.6, 2.4)\n",
        "\n",
        "    # Display the ciphertext.\n",
        "    draw_box(\n",
        "        x, 1.4, 5.2, 0.9,\n",
        "        \"Plaintext XOR Keystream = Ciphertext\",\n",
        "        encrypted.hex()[:32] + \"...\",\n",
        "        colors[i]\n",
        "    )\n",
        "\n",
        "\n",
        "# STEP 5 — Display the comparison result.\n",
        "different = ciphertexts[0] != ciphertexts[1]\n",
        "\n",
        "ax.text(\n",
        "    6.5, 0.55,\n",
        "    \"Same AES Key + Different TDMA Frame = Different Keystream\",\n",
        "    ha=\"center\",\n",
        "    fontsize=13,\n",
        "    fontweight=\"bold\",\n",
        "    color=\"#176B48\"\n",
        ")\n",
        "\n",
        "# Add the diagram title.\n",
        "ax.set_title(\n",
        "    \"AES-CTR — Effect of the TDMA Frame Number\",\n",
        "    fontsize=17,\n",
        "    fontweight=\"bold\",\n",
        "    pad=15\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"Ciphertexts differ:\", different)\n"
      ]
    },
