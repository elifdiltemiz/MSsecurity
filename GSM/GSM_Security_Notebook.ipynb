        "# ============================================================\n",
        "# GSM SECURITY LAB — REPLAY ATTACK (ONE CELL)\n",
        "# Educational A3 using HMAC-SHA256, not real GSM A3\n",
        "# ============================================================\n",
        "\n",
        "import secrets\n",
        "import hmac\n",
        "import hashlib\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. LEGITIMATE AUTHENTICATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def A3(key, rand):\n",
        "    # Return a 32-bit SRES (4 bytes)\n",
        "    return hmac.new(key, rand, hashlib.sha256).digest()[:4]\n",
        "\n",
        "# Shared secret between SIM and network (128 bits)\n",
        "Ki = bytes.fromhex(\"00112233445566778899AABBCCDDEEFF\")\n",
        "\n",
        "# Network generates RAND1 (128 bits)\n",
        "RAND1 = secrets.token_bytes(16)\n",
        "\n",
        "# SIM calculates its authentication response\n",
        "SRES1 = A3(Ki, RAND1)\n",
        "\n",
        "# Network verifies the response\n",
        "legitimate_ok = hmac.compare_digest(SRES1, A3(Ki, RAND1))\n",
        "\n",
        "# Attacker intercepts and records SRES1\n",
        "recorded_SRES = SRES1\n",
        "\n",
        "print(\"=== 1. LEGITIMATE AUTHENTICATION ===\")\n",
        "print(\"RAND1:\", RAND1.hex())\n",
        "print(\"SRES1:\", SRES1.hex())\n",
        "print(\"Authenticated:\", legitimate_ok)\n",
        "print(\"Attacker records SRES1:\", recorded_SRES.hex())\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. ATTACKER REPLAY\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# CASE A: Network sends a fresh RAND2\n",
        "RAND2 = secrets.token_bytes(16)\n",
        "while RAND2 == RAND1:\n",
        "    RAND2 = secrets.token_bytes(16)\n",
        "\n",
        "# Attacker replays old SRES1 instead of calculating SRES2\n",
        "expected_SRES2 = A3(Ki, RAND2)\n",
        "fresh_ok = hmac.compare_digest(recorded_SRES, expected_SRES2)\n",
        "\n",
        "# CASE B: Vulnerable network reuses RAND1\n",
        "expected_SRES1 = A3(Ki, RAND1)\n",
        "reuse_ok = hmac.compare_digest(recorded_SRES, expected_SRES1)\n",
        "\n",
        "print(\"\\n=== 2. ATTACKER REPLAY ===\")\n",
        "print(\"RAND2:\", RAND2.hex())\n",
        "print(\"Expected SRES2:\", expected_SRES2.hex())\n",
        "print(\"Attacker sends:\", recorded_SRES.hex())\n",
        "print(\"Fresh RAND accepted:\", fresh_ok)\n",
        "print(\"Reused RAND accepted:\", reuse_ok)\n",
