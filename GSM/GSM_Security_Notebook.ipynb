        "\n",
        "# ============================================================\n",
        "# GSM SECURITY LAB — PART 4\n",
        "# A8: SESSION KEY GENERATION\n",
        "# ============================================================\n",
        "\n",
        "import secrets\n",
        "import hmac\n",
        "import hashlib\n",
        "\n",
        "\n",
        "# STEP 1 — Define our educational A8 function.\n",
        "def demo_A8(key, rand):\n",
        "\n",
        "    # HMAC-SHA256 produces 32 bytes (256 bits).\n",
        "    # We keep 8 bytes to simulate GSM's 64-bit Kc.\n",
        "    return hmac.new(\n",
        "        key,\n",
        "        b\"GSM-DEMO-A8\" + rand,\n",
        "        hashlib.sha256\n",
        "    ).digest()[:8]\n",
        "\n",
        "\n",
        "# STEP 2 — SIM and home network share the same Ki.\n",
        "Ki_SIM = bytes.fromhex(\n",
        "    \"00112233445566778899AABBCCDDEEFF\"\n",
        ")\n",
        "\n",
        "Ki_NETWORK = Ki_SIM\n",
        "\n",
        "\n",
        "# STEP 3 — Generate a random 128-bit challenge.\n",
        "RAND = secrets.token_bytes(16)\n",
        "\n",
        "\n",
        "# STEP 4 — Both independently derive the session key.\n",
        "Kc_SIM = demo_A8(Ki_SIM, RAND)\n",
        "\n",
        "Kc_NETWORK = demo_A8(Ki_NETWORK, RAND)\n",
        "\n",
        "# Preserve Kc for the next A5 encryption experiment.\n",
        "Kc_A8_ORIGINAL = Kc_SIM\n",
        "\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(\"GSM A8 — SESSION KEY GENERATION\")\n",
        "print(\"=\" * 55)\n",
        "\n",
        "print(\"\\nRAND:\", RAND.hex())\n",
        "\n",
        "print(\"\\nSIM Kc:    \", Kc_SIM.hex())\n",
        "print(\"Network Kc:\", Kc_NETWORK.hex())\n",
        "\n",
        "# Verify that both sides derived the same key.\n",
        "keys_match = hmac.compare_digest(Kc_SIM, Kc_NETWORK)\n",
        "\n",
        "print(\"\\nKeys match:\", keys_match)\n",
        "print(\"Key length:\", len(Kc_SIM) * 8, \"bits\")\n",
        "\n",
        "\n",
        "\n",
        "print(\"\\nSECURITY CONCLUSION\")\n",
        "print(\"Same Ki + same RAND -> same Kc.\")\n",
        "print(\"Different RAND -> normally different Kc.\")\n",
        "print(\"Different Ki -> normally different Kc.\")\n",
        "print(\"Ki must remain secret; RAND does not.\")\n",
        "\n",
        "\n",
