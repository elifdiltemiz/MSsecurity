      "source": [
        "\n",
        "# ============================================================\n",
        "# GSM SECURITY LAB — TMSI REALLOCATION\n",
        "# Follows the sequence in the lecture slide\n",
        "#\n",
        "# Educational simulation:\n",
        "# A3/A8: HMAC-based teaching substitutes\n",
        "# A5: simplified XOR keystream (NOT actual A5/1)\n",
        "# No additional HMAC integrity layer\n",
        "# ============================================================\n",
        "\n",
        "import secrets\n",
        "import hmac\n",
        "import hashlib\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 1 — OLD TMSI STORED IN SIM\n",
        "# ============================================================\n",
        "\n",
        "IMSI = \"262010123456789\"\n",
        "LAI = \"262-01-1001\"\n",
        "\n",
        "SIM_TMSI = \"A1B2C3D4\"\n",
        "\n",
        "# VLR stores TMSI -> IMSI mapping\n",
        "VLR = {SIM_TMSI: IMSI}\n",
        "\n",
        "# Shared secret in SIM and AuC\n",
        "Ki = secrets.token_bytes(16)\n",
        "\n",
        "print(\"\\nSTEP 1 — OLD TMSI IN SIM\")\n",
        "print(\"Old TMSI:\", SIM_TMSI)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 2 — MS SENDS OLD LAI AND OLD TMSI\n",
        "# ============================================================\n",
        "\n",
        "old_TMSI = SIM_TMSI\n",
        "\n",
        "print(\"\\nSTEP 2 — MS -> NETWORK\")\n",
        "print(\"Message using old TMSI\")\n",
        "print(\"LAI old:\", LAI)\n",
        "print(\"TMSI old:\", old_TMSI)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 3 — VLR: TMSI-IMSI MAPPING\n",
        "# ============================================================\n",
        "\n",
        "found_IMSI = VLR.get(old_TMSI)\n",
        "\n",
        "if found_IMSI is None:\n",
        "    raise ValueError(\"Unknown TMSI\")\n",
        "\n",
        "print(\"\\nSTEP 3 — VLR: TMSI-IMSI MAPPING\")\n",
        "print(\"Old TMSI:\", old_TMSI)\n",
        "print(\"Mapped IMSI:\", found_IMSI)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 4 — AUTHENTICATION\n",
        "# ============================================================\n",
        "\n",
        "# Teaching substitutes for GSM A3 and A8.\n",
        "def A3(key, rand):\n",
        "    return hmac.new(\n",
        "        key, b\"A3\" + rand, hashlib.sha256\n",
        "    ).digest()[:4]\n",
        "\n",
        "def A8(key, rand):\n",
        "    return hmac.new(\n",
        "        key, b\"A8\" + rand, hashlib.sha256\n",
        "    ).digest()[:8]\n",
        "\n",
        "\n",
        "# Network generates authentication challenge\n",
        "RAND = secrets.token_bytes(16)\n",
        "\n",
        "# SIM computes SRES\n",
        "SIM_SRES = A3(Ki, RAND)\n",
        "\n",
        "# Network has expected SRES from AuC\n",
        "expected_SRES = A3(Ki, RAND)\n",
        "\n",
        "authenticated = hmac.compare_digest(\n",
        "    SIM_SRES, expected_SRES\n",
        ")\n",
        "\n",
        "if not authenticated:\n",
        "    raise ValueError(\"Authentication failed\")\n",
        "\n",
        "# Both sides obtain the same 64-bit Kc\n",
        "SIM_Kc = A8(Ki, RAND)\n",
        "NETWORK_Kc = A8(Ki, RAND)\n",
        "\n",
        "print(\"\\nSTEP 4 — AUTHENTICATION\")\n",
        "print(\"RAND:\", RAND.hex())\n",
        "print(\"SIM SRES:\", SIM_SRES.hex())\n",
        "print(\"Expected SRES:\", expected_SRES.hex())\n",
        "print(\"Authentication successful:\", authenticated)\n",
        "print(\"Kc:\", SIM_Kc.hex())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 5 — VLR: TMSI REASSIGNMENT\n",
        "# ============================================================\n",
        "\n",
        "new_TMSI = secrets.token_hex(4).upper()\n",
        "\n",
        "while new_TMSI in VLR:\n",
        "    new_TMSI = secrets.token_hex(4).upper()\n",
        "\n",
        "print(\"\\nSTEP 5 — VLR: TMSI REASSIGNMENT\")\n",
        "print(\"Old TMSI:\", old_TMSI)\n",
        "print(\"New TMSI:\", new_TMSI)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 6 — SAVE NEW TMSI IN NETWORK\n",
        "# ============================================================\n",
        "\n",
        "# Keep old mapping until reallocation completes.\n",
        "VLR[new_TMSI] = found_IMSI\n",
        "\n",
        "print(\"\\nSTEP 6 — SAVE NEW TMSI\")\n",
        "print(\"VLR database:\", VLR)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 7 — BSC: CIPHER A5\n",
        "# ============================================================\n",
        "\n",
        "# Simplified teaching cipher.\n",
        "# NOT a real implementation of GSM A5/1.\n",
        "#\n",
        "# A5 concept:\n",
        "#   Kc -> keystream\n",
        "#   plaintext XOR keystream -> ciphertext\n",
        "#\n",
        "# Receiver XORs the same keystream to decrypt.\n",
        "\n",
        "def A5_teaching(kc, data):\n",
        "    keystream = hashlib.sha256(\n",
        "        b\"A5-TEACHING\" + kc\n",
        "    ).digest()\n",
        "\n",
        "    return bytes(\n",
        "        byte ^ keystream[i]\n",
        "        for i, byte in enumerate(data)\n",
        "    )\n",
        "\n",
        "\n",
        "# New TMSI as 4 bytes\n",
        "plaintext = bytes.fromhex(new_TMSI)\n",
        "\n",
        "# Network encrypts\n",
        "ciphertext = A5_teaching(\n",
        "    NETWORK_Kc, plaintext\n",
        ")\n",
        "\n",
        "print(\"\\nSTEP 7 — BSC: CIPHER A5\")\n",
        "print(\"New TMSI:\", plaintext.hex().upper())\n",
        "print(\"Encrypted TMSI:\", ciphertext.hex().upper())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 8 — TMSI REALLOCATION COMMAND\n",
        "# ============================================================\n",
        "\n",
        "# Network sends ciphered new TMSI to MS\n",
        "received_ciphertext = ciphertext\n",
        "\n",
        "print(\"\\nSTEP 8 — NETWORK -> MS\")\n",
        "print(\"TMSI Reallocation Command\")\n",
        "print(\"Ciphered TMSI:\", received_ciphertext.hex().upper())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 9 — MS: A5 DECRYPTION AND SAVE NEW TMSI\n",
        "# ============================================================\n",
        "\n",
        "# MS uses its Kc to recover the new TMSI\n",
        "decrypted = A5_teaching(\n",
        "    SIM_Kc, received_ciphertext\n",
        ")\n",
        "\n",
        "SIM_TMSI = decrypted.hex().upper()\n",
        "\n",
        "print(\"\\nSTEP 9 — MS: A5 DECRYPTION\")\n",
        "print(\"Recovered TMSI:\", SIM_TMSI)\n",
        "print(\"Save new TMSI in SIM:\", SIM_TMSI)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 10 — TMSI REALLOCATION COMPLETE\n",
        "# ============================================================\n",
        "\n",
        "if SIM_TMSI != new_TMSI:\n",
        "    raise ValueError(\"TMSI reallocation failed\")\n",
        "\n",
        "print(\"\\nSTEP 10 — MS -> NETWORK\")\n",
        "print(\"TMSI Reallocation Complete\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 11 — DELETE OLD TMSI\n",
        "# ============================================================\n",
        "\n",
        "del VLR[old_TMSI]\n",
        "\n",
        "print(\"\\nSTEP 11 — NETWORK: DELETE OLD TMSI\")\n",
        "print(\"Old TMSI deleted:\", old_TMSI)\n",
        "print(\"New TMSI active:\", SIM_TMSI)\n",
        "\n",
        "print(\"\\nFINAL STATE\")\n",
        "print(\"SIM TMSI:\", SIM_TMSI)\n",
        "print(\"VLR:\", VLR)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# COMMUNICATION DIAGRAM — SAME ORDER AS LECTURE SLIDE\n",
        "# ============================================================\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(12, 10))\n",
        "\n",
        "x_ms = 1.5\n",
        "x_network = 9\n",
        "\n",
        "# Lifelines\n",
        "for x, name in [(x_ms, \"MS / SIM\"),\n",
        "                (x_network, \"Network / VLR / BSC\")]:\n",
        "    ax.plot([x, x], [0.5, 11.5],\n",
        "            \"--\", color=\"gray\", alpha=0.6)\n",
        "    ax.text(x, 11.8, name, ha=\"center\",\n",
        "            fontsize=12, fontweight=\"bold\")\n",
        "\n",
        "\n",
        "def arrow(x1, x2, y, label):\n",
        "    ax.annotate(\n",
        "        \"\", xy=(x2, y), xytext=(x1, y),\n",
        "        arrowprops=dict(arrowstyle=\"->\", lw=1.8)\n",
        "    )\n",
        "    ax.text(\n",
        "        (x1 + x2) / 2, y + 0.18,\n",
        "        label, ha=\"center\", fontsize=10\n",
        "    )\n",
        "\n",
        "\n",
        "def operation(x, y, label):\n",
        "    ax.text(\n",
        "        x, y, label,\n",
        "        ha=\"center\", va=\"center\",\n",
        "        fontsize=9,\n",
        "        bbox=dict(boxstyle=\"round,pad=0.4\",\n",
        "                  facecolor=\"lightblue\",\n",
        "                  edgecolor=\"black\")\n",
        "    )\n",
        "\n",
        "\n",
        "# Initial state\n",
        "operation(x_ms, 11, \"Old TMSI in SIM\")\n",
        "\n",
        "# Identification\n",
        "arrow(x_ms, x_network, 10.3,\n",
        "      \"LAI old, TMSI old\")\n",
        "\n",
        "operation(x_network, 9.6,\n",
        "          \"VLR: TMSI-IMSI mapping\")\n",
        "\n",
        "# Authentication\n",
        "ax.plot([x_ms, x_network], [8.8, 8.8],\n",
        "        color=\"black\", lw=1.5)\n",
        "ax.text(5.25, 9.0, \"Authentication\",\n",
        "        ha=\"center\", fontsize=11,\n",
        "        fontweight=\"bold\")\n",
        "\n",
        "# Reassignment\n",
        "operation(x_network, 8.1,\n",
        "          \"VLR: TMSI reassignment\")\n",
        "\n",
        "operation(x_network, 7.3,\n",
        "          \"Save new TMSI\")\n",
        "\n",
        "operation(x_network, 6.5,\n",
        "          \"BSC: Cipher A5\")\n",
        "\n",
        "# Reallocation command\n",
        "arrow(x_network, x_ms, 5.6,\n",
        "      \"TMSI Reallocation Command\\n(ciphered new TMSI)\")\n",
        "\n",
        "# MS processing\n",
        "operation(x_ms, 4.7,\n",
        "          \"A5: Decrypt using Kc\")\n",
        "\n",
        "operation(x_ms, 3.9,\n",
        "          \"Save new TMSI in SIM\")\n",
        "\n",
        "# Completion\n",
        "arrow(x_ms, x_network, 3.0,\n",
        "      \"TMSI Reallocation Complete\")\n",
        "\n",
        "# Delete old TMSI\n",
        "operation(x_network, 2.1,\n",
        "          \"Delete old TMSI\")\n",
        "\n",
        "ax.set_xlim(-1, 11.5)\n",
        "ax.set_ylim(1, 12.4)\n",
        "ax.axis(\"off\")\n",
        "\n",
        "plt.title(\n",
        "    \"GSM TMSI Reallocation — Lecture Slide Sequence\",\n",
        "    fontsize=14, fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
